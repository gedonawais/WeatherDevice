[Unit]
Description=Weather Camera Service
After=NetwrokManager.service network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/WeatherDevice/Firmware/RPi/weather.py
WorkingDirectory=/home/WeatherDevice/Firmware/RPi

StandardOutput=journal
StandardError=journal
Restart=always
User=root

[Install]
WantedBy=multi-user.target
